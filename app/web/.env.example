# Interface locale d'AlphaForge AI : copier ce fichier en .env.local puis l'adapter.
# Le serveur Next.js lit ces variables; aucune n'est exposée au navigateur.

# mock : simulateur en mémoire du contrat (aucun appel réseau, idéal pour développer et pour la démo)
# local : runtime Python `profile` lancé sur le poste (LOCAL_AGENT_URL)
# aws : Bedrock AgentCore (InvokeAgentRuntime) et Step Functions, avec les identifiants AWS du poste
AGENT_MODE=mock

# Runtime `profile` lancé en local :
#   cd app/agents && AGENT_ROLE=profile ALPHAFORGE_STORE=local uv run python main.py
# Il n'écoute que sur 127.0.0.1 : garder cette adresse plutôt que localhost, que Node peut résoudre d'abord en IPv6 (::1).
LOCAL_AGENT_URL=http://127.0.0.1:8080/invocations

# Région AWS des runtimes AgentCore et de la machine Step Functions.
AWS_REGION=us-east-1

# Préfixe des runtimes AgentCore : l'ARN de `<préfixe>_profile` est trouvé par son nom (ListAgentRuntimes).
ALPHAFORGE_PREFIX=alphaforge_sandbox

# Machine de collecte de la base générale, trouvée par son nom (ListStateMachines).
ALPHAFORGE_STATE_MACHINE=alphaforge-sandbox-collecte

# Identifiants AWS : chaîne par défaut du SDK (AWS_PROFILE, variables AWS_ACCESS_KEY_ID..., SSO).
# Ne jamais mettre de clé dans ce fichier; préférer par exemple :
# AWS_PROFILE=datathon
