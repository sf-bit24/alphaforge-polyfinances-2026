# Variables locales d'AlphaForge AI. ./scripts/init.sh copie ce fichier en .env (ignoré par git), puis
# ./scripts/run.sh l'exporte vers l'interface et les runtimes Python. Aucune variable n'est exposée au navigateur.

# Mode par défaut de ./scripts/run.sh (un argument le remplace : ./scripts/run.sh local) :
#   mock  : simulateur en mémoire du contrat, aucun appel réseau
#   local : runtimes Python `profile` et `portfolio` lancés sur le poste, modèles Bedrock réels
#   aws   : runtimes Bedrock AgentCore et Step Functions déployés, avec les identifiants AWS du poste
AGENT_MODE=mock

# Identifiants AWS (modes local et aws) : chaîne par défaut du SDK (AWS_PROFILE, AWS_ACCESS_KEY_ID..., SSO).
# Ne jamais mettre de clé dans ce fichier ; préférer un profil :
# AWS_PROFILE=datathon
AWS_REGION=us-east-1

# Mode local : adresses des runtimes (run.sh les lance sur ces ports). Garder 127.0.0.1 plutôt que localhost,
# que Node peut résoudre d'abord en IPv6 (::1).
LOCAL_AGENT_URL=http://127.0.0.1:8080/invocations
LOCAL_PORTFOLIO_URL=http://127.0.0.1:8081/invocations

# Mode aws : runtimes et machine de collecte trouvés par leur nom (ListAgentRuntimes, ListStateMachines).
ALPHAFORGE_PREFIX=alphaforge_sandbox
ALPHAFORGE_STATE_MACHINE=alphaforge-sandbox-collecte

# Connexion des investisseurs (CONTRACTS.md section 7.1).
# off : sans connexion, le navigateur garde son client_id.
# cognito : connexion Amazon Cognito obligatoire ; un compte = un client_id. Les variables suivantes sont alors
# requises (outputs auth_issuer, auth_client_id et auth_domain de infrastructure/infra ; le client Cognito accepte
# http://localhost:3000).
AUTH_MODE=off
# COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# COGNITO_DOMAIN=https://alphaforge-sandbox-123456789012.auth.us-east-1.amazoncognito.com
# APP_URL=http://localhost:3000
# Clé du cookie de session (32 caractères au moins), par exemple : openssl rand -hex 32
# AUTH_SESSION_SECRET=
# « Supprimer mon compte » avec AGENT_MODE=aws et AUTH_MODE=cognito (posées par Terraform sur la tâche ECS, auth.tf).
# Attention : la suppression agit alors sur le vrai compte AWS, avec les identifiants du poste.
# ALPHAFORGE_BUCKET=alphaforge-sandbox-kb-123456789012
# ALPHAFORGE_CLIENT_KB_PREFIX=alphaforge-sandbox
# ALPHAFORGE_CLIENT_KB_VECTOR_BUCKET=alphaforge-sandbox-client-vectors
