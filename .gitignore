# Secrets locaux : jamais commites.
.env
.env.*
!.env.example

# État local de Claude Code (worktrees, réglages du poste) et export des bases OKF (scripts/export-okf.sh)
.claude/
/export/

# Documents du Datathon, copies dans le Brain : non versionnes ici.
# Exceptions : l'architecture (docs/architecture/), les cas d'utilisation
# (docs/use-cases/) et, dans docs/remise/, les seuls documents remis au jury
# (leurs sources de travail restent locales).
/docs/*
!/docs/architecture/
!/docs/use-cases/
!/docs/remise/
/docs/remise/*
!/docs/remise/README.md
!/docs/remise/alphaforge-one-pager.pdf
!/docs/remise/alphaforge-architecture-aws.pdf
!/docs/remise/alphaforge-documentation-technique.pdf

# Traces du moteur de backtest (défaut ./backtest-results, où qu'on le lance)
backtest-results/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Traçabilité locale (peut contenir des prompts) et sorties d'infra (identifiant du compte)
app/agents/.traces/
# anciens emplacements (copies locales encore présentes sur certains postes)
research/finance/traces/
research/finance/infra/outputs.json
