# Environnement et caches locaux.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Base de connaissances locale (ALPHAFORGE_STORE=local) : profils de test, jamais versionnés.
.local-kb/

# Sorties de construction et de package.sh.
build/
dist/
*.egg-info/
*.zip

# Secrets locaux.
.env
.env.*

# Moteur de backtest (alphaforge.finance.backtest) : données longues reconstruites, jamais versionnées.
# Une partie dérive de Yahoo/yfinance (redistribution interdite) et de séries Moody's / OCDE (droit d'auteur) :
# python -m alphaforge.finance.backtest.build_data. Le catalogue (assets.csv, coverage.csv, qa_overlap.csv,
# data_version.json) et SOURCES.md restent versionnés. raw/ = téléchargements bruts non fiables.
src/alphaforge/data/long/*.parquet
src/alphaforge/data/long/raw/
# Traces écrites par le moteur hors d'un checkout (défaut ./backtest-results).
backtest-results/
# Études (scripts/backtest) : les traces brutes (~650 Mo) sont reproductibles ; seules les synthèses
# results/*_analysis/ et results/decisions/ sont versionnées. data_ext/ = copies dérivées locales des études.
scripts/backtest/results/*
!scripts/backtest/results/*_analysis/
!scripts/backtest/results/decisions/
scripts/backtest/results/**/*_scratch*
scripts/backtest/analysis/*/data_ext/
scripts/backtest/**/*.log
*.xls
*.xlsx
