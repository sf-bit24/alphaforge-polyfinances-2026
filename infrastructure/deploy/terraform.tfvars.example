# =============================================================================
# Exemple de reference, NON utilise par le pipeline. Les vraies valeurs vivent
# dans deploy/envs/<env>.tfvars (copie en terraform.auto.tfvars dans le bundle
# par scripts/upload-config.sh), et release_id dans deploy/release.auto.tfvars,
# artefact du pipeline (scripts/write-release-tfvars.sh).
# =============================================================================

environment = "sandbox" # sandbox | nprod | prod
aws_region  = "us-east-1"
release_id  = "1a2b3c4d" # SHA court du commit, jamais un tag mobile

tfc_aws_run_role_arn     = "arn:aws:iam::123456789012:role/alphaforge-tfc-run"
kms_admin_principal_arns = ["arn:aws:iam::123456789012:role/WSParticipantRole"]

collecte_schedule_expression = "cron(0 6 * * ? *)"
collecte_schedule_enabled    = true

additional_tags = {
  Owner = "larpathon"
}
